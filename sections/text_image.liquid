{% style %}
  @media (min-width: 768px) {
    #section-{{section.id}}.text-image {
     display: flex;
     height: 500px;
    }
  }
  #section-{{section.id}} .text-image__image img{
    width: 100%;
    height: 215px;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    #section-{{section.id}} .text-image__image img{
      height: 100%;
    }
  }

  @media (min-width: 768px) {
    #section-{{section.id}} .text-image__image{
      width: 50%;
    }
  }

  #section-{{section.id}} .text-image__text{
    background-color: var(--dark-grey);
    color: var(--white);
  }

  @media (min-width: 768px) {
    #section-{{section.id}} .text-image__text{
      width: 50%;
    }
  }

  #section-{{section.id}} .text-image__text__inner{
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    text-align: {{ section.settings.text_alignment }};
  }

  @media (min-width: 768px) {
  #section-{{section.id}} .text-image__text__inner{
    justify-content: center;
    height: 100%;
    padding: 60px 80px;
  }
}

  #section-{{section.id}} .text-image__text__inner h2 {
    font-size: var(--size-10);
    }

  #section-{{section.id}} .text-image__text__inner p {
  font-size: var(--size-4);
  }


  #section-{{section.id}} .text-image__text__btn {
    color: var(--white);
    text-transform: uppercase;
  }
{% endstyle %}

<div class="text-image" id="section-{{section.id}}">
  <div class="text-image__image">
    <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title }}">
  </div>
  <div class="text-image__text">
    <div class="text-image__text__inner">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.description }}</p>
      {% if section.settings.button_link and section.settings.button_text %}
        <a class="text-image__text__btn" href="{{ section.settings.button_link }}">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text Image",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Text Image"
    }
  ]
}
{% endschema %}